# build output
/bin/
/dist/
/kudurru
*.test
*.out
coverage.*

# generated at build time (committed generated files live under api/ and config/crd/bases)
# web/dist/index.html is a committed placeholder so Go builds without Bun;
# `make web-build` overwrites it and writes the hashed bundle into assets/.
/web/dist/assets/
/web/dist/third-party-licenses.txt
/web/node_modules/
/web/coverage/

# local state
/.context/
/.env
*.db
*.db-wal
*.db-shm
/hack/.cache/

# editors
.idea/
.vscode/
*.swp
.DS_Store

# agent worktrees live inside the repo
/.claude/

# docs site (site/): build output, Hugo's cache and the generated assets
/site/public/
/site/resources/
/site/.generated/
/site/.hugo_build.lock
