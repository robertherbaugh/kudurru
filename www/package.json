    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@types/bun": "1.4.2",
    "typescript": "6.0.3",
    "wrangler": "4.149.0"
  }
}
