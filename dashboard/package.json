{
  "name": "@kudurru/dashboard",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN ../LICENSE",
  "type": "module",
  "description": "The kudurru dashboard SPA (dev-docs/design-record.md §10, decision D69).",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vite build && bun scripts/licenses.ts && bun scripts/budget.ts && bun scripts/compress.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --max-warnings 0 . && bun run themes:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "bunx openapi-typescript@7.13.0 ../api/openapi.json -o src/api/generated.ts",
    "e2e": "playwright test",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "themes:build": "astryx theme build src/themes/kudurru/kudurruTheme.ts src/themes/neutral/neutralTheme.ts src/themes/stone/stoneTheme.ts src/themes/y2k/y2kTheme.ts",
    "themes:check": "astryx theme build --check src/themes/kudurru/kudurruTheme.ts src/themes/neutral/neutralTheme.ts src/themes/stone/stoneTheme.ts src/themes/y2k/y2kTheme.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "0.6.8",
    "@astryxdesign/theme-neutral": "0.6.8",
    "@astryxdesign/theme-stone": "0.6.8",
    "@astryxdesign/theme-y2k": "0.6.8",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-virtual": "3.14.14",
    "echarts": "6.1.0",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.6.8",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "msw": "3.0.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
