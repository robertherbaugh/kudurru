# /etc/kudurru/kudurru.env: environment for kudurru.service (a config file:
# upgrades keep your edits). KUDURRU_<SECTION>__<KEY> overrides a settings
# key (`kudurru config schema`); the *_FILE variables name secret files that
# must be readable by the kudurru user (chgrp kudurru, chmod 0640).
#
# Cluster encryption key: sealed sessions, stored secrets, internal TLS.
# Create it once:  openssl rand -base64 32 > /etc/kudurru/encryption_key
#KUDURRU_ENCRYPTION_KEY_FILE=/etc/kudurru/encryption_key
#
# First-start admin password (read only while no user exists); without it
# a password is generated and logged once.
#KUDURRU_ADMIN_PASSWORD_FILE=/etc/kudurru/admin_password
#
#KUDURRU_LOG__LEVEL=info
