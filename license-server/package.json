{
  "name": "@kudurru/license-server",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "description": "The licensor's service that issues kudurru license keys after an OIDC sign-in: Bun, TypeScript and Postgres in one container, with an Astryx UI.",
  "scripts": {
    "dev": "bun run dev:server & bun run dev:ui; wait",
    "dev:server": "bun --watch server/main.ts",
    "dev:ui": "vite",
    "build": "bun run build:ui && bun run build:server",
    "build:ui": "vite build && bun scripts/licenses.ts",
    "build:server": "bun build server/main.ts --target=bun --production --outfile=dist/server.js && bun build server/healthcheck.ts --target=bun --production --outfile=dist/healthcheck.js",
    "start": "bun dist/server.js",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p ui/tsconfig.json && tsc -p tsconfig.tools.json",
    "lint": "eslint --max-warnings 0 . && bun run themes:check",
    "test": "bun run test:server && bun run test:ui",
    "test:server": "bun test",
    "test:ui": "vitest run",
    "e2e": "playwright test",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "themes:build": "astryx theme build ui/src/themes/kudurru/kudurruTheme.ts",
    "themes:check": "astryx theme build --check ui/src/themes/kudurru/kudurruTheme.ts",
    "ui:drift": "bun scripts/ui-drift.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "0.6.8",
    "@astryxdesign/theme-neutral": "0.6.8",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-query": "5.104.2",
    "lucide-react": "1.55.0",
    "nodemailer": "10.1.0",
    "openid-client": "6.8.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.6.8",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/bun": "1.4.3",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jose": "6.2.12",
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
