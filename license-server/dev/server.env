# Settings of a license server run on the host against the compose
# Postgres, Dex and Mailpit (make license-server-dev, which runs
# `bun --env-file=dev/server.env run dev` in license-server/). The same as
# the license-server service in compose.yaml, adjusted for the host: the
# browser talks to Vite on 5174, which proxies /api to Bun on 8790. Paths
# are relative to license-server/. No secret is in this file; the key and
# the client secret are the files scripts/dev-keygen.ts writes.
PUBLIC_URL=http://localhost:5174
LICENSE_SERVER_DEV=true
DATABASE_URL=postgres://postgres:postgres@localhost:55432/license_portal
DATABASE_TLS=disable
OIDC_ISSUER=http://localhost:5556/dex
OIDC_CLIENT_ID=license-portal
OIDC_CLIENT_SECRET_FILE=dev/secrets/oidc_client_secret
OIDC_SCOPES="openid profile email groups"
OIDC_DISPLAY_NAME="Sign in with Dex (development)"
ROLE_SUPERADMIN_GROUPS=license-superadmins
ROLE_LICENSE_ADMIN_GROUPS=license-admins
# Dev only; production needs a rule outsiders cannot satisfy (compose.yaml).
OIDC_ADMIN_CLAIM_RULES=email_verified=true
LICENSE_SIGNING_KEY_FILE=dev/secrets/signing.key
LICENSE_SIGNING_KID=dev-1
LICENSE_TRUSTED_KEYS_DIR=dev/trusted-keys
SMTP_URL=smtp://localhost:1025
ADMIN_NOTIFY_EMAIL=admin@example.org
PUBLIC_FORM_ORIGINS=http://localhost:8792
