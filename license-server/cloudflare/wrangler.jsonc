// The kudurru license portal on Cloudflare Containers (README.md in this
// directory). The Worker (src/index.ts) hands every request to one Durable
// Object, LicensePortal, which runs the portal's image as its container.
//
// Secrets: GitHub environment license-portal-production (README.md).
// `bun run deploy` supplies them with `wrangler deploy --secrets-file`.
// Only their names belong in this file; never put credentials in vars.
//   DATABASE_URL          your existing cloud database URL, or the optional runtime
//                         role (license-server/deploy/postgres-roles.sql). The direct endpoint
//                         (PlanetScale: port 5432), not a transaction pooler (README.md, "One-time setup");
//                         ?sslmode=verify-full may stay in the URL
//   OIDC_CLIENT_SECRET    the IdP's client secret for OIDC_CLIENT_ID
//   LICENSE_SIGNING_KEY   the signing seed, licensegen format (std base64 of the 32-byte seed)
//   SMTP_URL              smtps://api_token:<API token>@smtp.mx.cloudflare.net:465 (Cloudflare
//                         Email Service) or any provider's smtps:// or smtp:// URL
// The deploy script migrates automatically using DATABASE_MIGRATE_URL
// when supplied, otherwise DATABASE_URL (the simple single-role setup).
// With separate roles, only CI holds the owner's credentials:
// the deploy script enforces MIGRATE_ON_START=false; DATABASE_MIGRATE_URL
// is never uploaded to the Worker.
// A changed var or secret reaches the running container at the next cron
// tick (within 5 minutes): the Durable Object restarts it (README.md,
// "Changing configuration").
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kudurru-license-portal",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  // Persist Worker/Durable Object logs and traces in the dashboard.
  // Approval and invitation tokens in URL queries must not be recorded.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true }
  },

  // The only way in is PUBLIC_URL: no *.workers.dev or preview URL, whose
  // origin would fail the server's CSRF check and the OIDC redirect URI.
  "workers_dev": false,
  "preview_urls": false,
  // The kudurru.io zone must be in the same Cloudflare account; the first
  // successful deploy creates the DNS record and certificate for
  // licenses.kudurru.io. Turn on "Always Use HTTPS" for the zone (the
  // Worker also redirects http to https).
  "routes": [{ "pattern": "licenses.kudurru.io", "custom_domain": true }],

  "secrets": {
    "required": ["DATABASE_URL", "OIDC_CLIENT_SECRET", "LICENSE_SIGNING_KEY", "SMTP_URL"]
  },

  // All non-secret server settings come from GitHub variables in the
  // license-portal-production environment (README.md). `bun run deploy`
  // adds them to a temporary config; unset optional settings use the
  // server's defaults. No runtime vars are stored in this file.

  // Every 5 minutes the Worker asks the container's /readyz: it keeps the
  // container running (sleepAfter is 15 minutes, src/index.ts), so nobody
  // waits for a cold start and the server's 10-minute cleanup keeps its
  // schedule, and it applies changed vars and secrets. Remove the line to
  // let the portal sleep when idle (README.md, "Costs").
  "triggers": { "crons": ["*/5 * * * *"] },

  "containers": [
    {
      "class_name": "LicensePortal",
      // Container stdout/stderr (the server's JSON logs) in the dashboard.
      "observability": { "enabled": true, "logs": { "enabled": true } },
      // Placeholder for offline checks. `bun run deploy` builds, pushes and
      // replaces this in a temporary config using the account ID, commit
      // and deployment attempt. Never edit it for individual releases. Not
      // ../Dockerfile: wrangler pipes the Dockerfile to `docker build -f -`,
      // so BuildKit never reads license-server/Dockerfile.dockerignore (the
      // allowlist), and the repository's .dockerignore excludes
      // license-server/ entirely. Use a new tag for every release; a deploy
      // with an unchanged image starts no rollout.
      "image": "registry.cloudflare.com/<ACCOUNT_ID>/kudurru-license-server:0.1.0",
      // 1/4 vCPU, 1 GiB memory, 4 GB disk. lite (1/16 vCPU, 256 MiB) makes
      // every start (bundle load, migrations, TLS to Postgres) and every
      // TLS handshake to the IdP and SMTP slow, and leaves little room
      // for Bun's heap; always on, basic costs about 5 USD a month more.
      "instance_type": "basic",
      // One Durable Object name, so one container serves. The second slot
      // is headroom in case a rollout or host move starts the replacement
      // before the old instance has released its slot.
      "max_instances": 2,
      // Replace the instance in one step. The server drains for up to 20
      // seconds on SIGTERM; requests in that window get the Worker's 503
      // with Retry-After.
      "rollout_step_percentage": 100,
      "rollout_active_grace_period": 0,
      // Start the container near Postgres: every request makes several
      // queries. Regions: ENAM, WNAM, EEUR, WEUR, APAC, SAM, ME, OC, AFR.
      // "constraints": { "regions": ["WEUR"] },
      // No SSH: the container's environment holds the signing key. The
      // image is distroless, so there would be no shell anyway.
      "ssh": { "enabled": false }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "PORTAL", "class_name": "LicensePortal" }]
  },
  // The current declarative form (not the legacy "migrations" array; the
  // two cannot be combined, and a Worker deployed with exports cannot go
  // back).
  "exports": {
    "LicensePortal": { "type": "durable-object", "storage": "sqlite" }
  }
}
