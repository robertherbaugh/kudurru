// kudurru.io on Cloudflare Workers: static assets only, no Worker script,
// so requests never count as Worker invocations. Workers Builds deploys it
// from GitHub (website/README.md, "Deploying"). Headers come from dist/_headers
// (src/headers.ts); the alias domains (www.kudurru.io, kudurru.app,
// kudurru.dev) are redirected by a Cloudflare Bulk Redirect, not here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kudurru-www",
  "compatibility_date": "2026-10-01",
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "assets": {
    "directory": "./dist",
    // Unknown paths get dist/404.html with status 404.
    "not_found_handling": "404-page",
    // /licenses redirects to /licenses/, which serves licenses/index.html.
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "kudurru.io", "custom_domain": true }],
  // Static assets and compatibility settings also apply to Worker Previews.
  // This site has no bindings or variables needing separate preview settings.
  "previews": {},
  // The production *.workers.dev URL stays off. Worker Previews get their
  // own URLs; preview_urls also keeps version URLs available.
  "workers_dev": false,
  "preview_urls": true
}
