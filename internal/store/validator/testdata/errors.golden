  "error": {
    "key": "invalid",
    "message": "DNSZone.kudurru.io \"Home_Zone\" is invalid: metadata.name: Invalid value: \"Home_Zone\": a lowercase RFC 1123 subdomain must consist of lower case alphanumeric characters, '-' or '.', and must start and end with an alphanumeric character (e.g. 'example.com', regex used for validation is '[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*')",
    "hint": "fix the listed fields and retry: metadata.name",
    "fields": [
      "metadata.name"
    ]
  }
}

