// docs.kudurru.io on Cloudflare Workers: static assets only, no Worker
// script, so requests never count as Worker invocations. Workers Builds
// deploys it from GitHub (site/README.md, "Publishing"); nothing in this
// repository holds Cloudflare credentials. Response headers come from
// static/_headers, which Hugo copies to public/_headers.
{
  "$schema": "https://workers.cloudflare.com/wrangler-config-schema.json",
  // Workers Builds matches the dashboard project name to this name. The
  // website (www/) is "kudurru-www".
  "name": "kudurru-docs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    // Unknown paths get public/404.html with status 404.
    "not_found_handling": "404-page",
    // Hugo writes <page>/index.html; /guide redirects to /guide/.
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "docs.kudurru.io", "custom_domain": true }],
  // The *.workers.dev URL stays off; preview builds get version URLs.
  "workers_dev": false,
  "preview_urls": true
}
